{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Presence",
  "version": "0.4.0",
  "identifier": "com.customrichpresence.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Discord Presence",
        "url": "index.html",
        "width": 980,
        "height": 660,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
