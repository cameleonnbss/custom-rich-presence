{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Custom Rich Presence",
  "version": "0.3.0",
  "identifier": "com.customrichpresence.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Custom Rich Presence",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Présence",
        "url": "index.html?window=overlay",
        "width": 360,
        "height": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
